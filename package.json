{
  "name": "mp3-frame-counter",
  "version": "1.0.0",
  "private": true,
  "description": "Count physical MPEG-1 Layer III frames through a bounded upload API.",
  "type": "module",
  "engines": {
    "node": "^24.22.3"
  },
  "scripts": {
    "dev": "node --watch src/server.ts",
    "start": "node dist/server.js",
    "build": "node scripts/clean.ts && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "npm run build && vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "npm run build && vitest run tests/integration",
    "test:coverage": "npm run build && vitest run --coverage",
    "verify": "npm run lint && npm run typecheck && npm run test:coverage",
    "fixtures:verify": "node scripts/verify-fixtures.ts"
  },
  "dependencies": {
    "@fastify/multipart": "10.1.8",
    "fastify": "5.12.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
